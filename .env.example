# ---------------------------------------------------------------------------
# All of these are optional. With none of them set, the site builds and runs
# from the bundled records in data/associations.ts.
# ---------------------------------------------------------------------------

# Deployment URL. Makes Open Graph image URLs absolute.
# NEXT_PUBLIC_SITE_URL=https://hoa-engine.vercel.app

# Supabase — enables database-backed association records and photo storage.
# Both must be set for the integration to activate; if either is missing the
# app falls back to the bundled records.
#
# The publishable key is safe to expose: the `hoa_associations` RLS policy
# only exposes rows where `published` is true, and every write is admin-only.
# NEXT_PUBLIC_SUPABASE_URL=https://whlrbqdqxrpipthxmcbs.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic — powers the community guide on enabled demo concepts.
# Server-side only. It must NOT be prefixed NEXT_PUBLIC_, or Next.js will
# inline it into the browser bundle and publish your key.
# ANTHROPIC_API_KEY=sk-ant-...
